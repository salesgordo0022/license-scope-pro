# Copie para `.env` e preencha. O arquivo `.env` real NÃO deve ser versionado.

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
VITE_SUPABASE_URL=""

# Chave "publishable"/anon do Supabase. É pública por natureza (vai no bundle do
# navegador); a proteção real dos dados vem das policies de RLS, não desta chave.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Origens liberadas no CORS das Edge Functions, separadas por vírgula.
# Ex.: https://app.suaempresa.com.br,http://localhost:8080
ALLOWED_ORIGINS="http://localhost:8080"

# Habilita o formulário de auto-cadastro na tela de login.
# Mantenha "false" em produção: usuários devem ser criados por um admin.
VITE_ENABLE_PUBLIC_SIGNUP="false"
